rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function myEmail() {
      return request.auth.token.get('email', '').lower();
    }

    function adminConfigPath() {
      return /databases/$(database)/documents/users/public/settings/admin;
    }

    function rootProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function publicProfilePath() {
      return /databases/$(database)/documents/users/public/users/$(request.auth.uid);
    }

    // Super admin: the owner account, or the one configured in users/public/settings/admin
    function isSuperEmail() {
      return myEmail() == 'gonyisland@naver.com'
        || (exists(adminConfigPath())
            && myEmail() == get(adminConfigPath()).data.get('superAdminEmail', '').lower());
    }

    // Mirrors the client's isAdmin: super admin, configured admins, or role on the user's own root profile
    function isAdmin() {
      return signedIn() && (
        isSuperEmail()
        || (exists(adminConfigPath())
            && myEmail() in get(adminConfigPath()).data.get('allowedAdmins', []))
        || (exists(rootProfilePath())
            && get(rootProfilePath()).data.get('role', 'user') == 'admin')
      );
    }

    // True once the member has clicked Firebase's email verification link (v1.3.6)
    function emailVerified() {
      return request.auth.token.get('email_verified', false) == true;
    }

    // Approval status from the root profile (falls back to the shared copy).
    // Profiles created before the approval flow have no status and count as approved.
    function profileStatus() {
      return exists(rootProfilePath())
        ? get(rootProfilePath()).data.get('status', 'approved')
        : exists(publicProfilePath())
          ? get(publicProfilePath()).data.get('status', 'approved')
          : 'pending';
    }

    // Writes to shared content require an admin, an approved member, or a member who has
    // verified their email (sign-up needs no admin since v1.3.6). Restricted members never write.
    function canWrite() {
      return signedIn() && (isAdmin() || (profileStatus() != 'rejected'
        && (profileStatus() == 'approved' || emailVerified())));
    }

    // Members may never change their own role, permissions or approval status
    function protectedUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'permissions', 'status']);
    }

    // A pending member with a verified email may approve themselves, and change nothing else with it
    function selfApproval() {
      return emailVerified()
        && resource.data.get('status', '') == 'pending'
        && request.resource.data.get('status', '') == 'approved'
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'permissions']);
    }

    // New profiles start as a pending member (the super admin initializes itself)
    function validNewProfile() {
      return isSuperEmail()
        || (request.resource.data.get('role', 'user') == 'user'
            && request.resource.data.get('status', '') == 'pending');
    }

    // ── Private profile (root) ───────────────────────────────
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && ((request.auth.uid == userId && validNewProfile()) || isAdmin());
      allow update: if signedIn() && ((request.auth.uid == userId && (protectedUnchanged() || selfApproval())) || isAdmin());
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
    }

    // Private per-user subcollections (never matches the shared 'public' tree)
    match /users/{userId}/{col}/{rest=**} {
      allow read, write: if userId != 'public' && signedIn() && request.auth.uid == userId;
    }

    // ── Shared profiles: owner and admins only ───────────────
    match /users/public/users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && ((request.auth.uid == uid && validNewProfile()) || isAdmin());
      allow update: if signedIn() && ((request.auth.uid == uid && (protectedUnchanged() || selfApproval())) || isAdmin());
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // ── Shared settings: operator-authored (landing, ticker, music, city list, presets) ──
    // admin: signed-in users read it to resolve admin status. The old shared pockets, wishlist
    // and migration marker are operator-only since v1.3.6 (members keep their own copies).
    match /users/public/settings/{docId} {
      allow read: if docId == 'admin' ? signedIn()
        : (docId in ['pockets', 'map_wishlist', 'migration'] || docId.matches('pendingApproval_.*')) ? isAdmin()
        : true;
      allow write: if isAdmin();
    }

    // ── Legacy shared calendar (members use users/{uid}/calendar_events since v1.3.6) ──
    match /users/public/calendar_events/{rest=**} {
      allow read, write: if isAdmin();
    }

    // ── Own content (v1.3.6) ─────────────────────────────────
    // Every journey document carries ownerId (who made it), access (who may read it), editors
    // (who may edit it besides the owner) and publicShare (open to its share link). Items of a
    // journey (timeline, flights, stays, transits) copy the same fields.
    function me() {
      return request.auth.uid;
    }

    function canRead(d) {
      return d.get('publicShare', false) == true
        || (signedIn() && (d.get('ownerId', '') == me() || me() in d.get('access', [])));
    }

    function ownershipUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['ownerId', 'access', 'editors', 'publicShare']);
    }

    // The owner may change anything but the owner; an editor may change the content only
    function canUpdate() {
      return canWrite() && (
        (resource.data.get('ownerId', '') == me() && request.resource.data.get('ownerId', '') == me())
        || (me() in resource.data.get('editors', []) && ownershipUnchanged()));
    }

    // The journey an item belongs to, as it will be after this write (a batch may create both)
    function journeyAfter(tripId) {
      return existsAfter(/databases/$(database)/documents/users/public/trips/$(string(tripId)))
        ? getAfter(/databases/$(database)/documents/users/public/trips/$(string(tripId))).data
        : getAfter(/databases/$(database)/documents/users/public/plans/$(string(tripId))).data;
    }

    function canEditJourney(tripId) {
      return (existsAfter(/databases/$(database)/documents/users/public/trips/$(string(tripId)))
          || existsAfter(/databases/$(database)/documents/users/public/plans/$(string(tripId))))
        && (journeyAfter(tripId).get('ownerId', '') == me() || me() in journeyAfter(tripId).get('editors', []));
    }

    match /users/public/{col}/{docId} {
      allow read: if col in ['trips', 'plans', 'timeline', 'flights', 'stays', 'transits']
        && canRead(resource.data);

      // A new journey belongs to whoever makes it
      allow create: if col in ['trips', 'plans'] && canWrite()
        && request.resource.data.get('ownerId', '') == me()
        && me() in request.resource.data.get('access', []);
      allow update: if col in ['trips', 'plans'] && canUpdate();
      allow delete: if col in ['trips', 'plans'] && canWrite() && resource.data.get('ownerId', '') == me();
    }

    match /users/public/{col}/{docId} {
      // Items are written by the journey's owner or its editors
      allow create: if col in ['timeline', 'flights', 'stays', 'transits'] && canWrite()
        && canEditJourney(request.resource.data.get('tripId', -1));
      allow update: if col in ['timeline', 'flights', 'stays', 'transits'] && canUpdate();
      allow delete: if col in ['timeline', 'flights', 'stays', 'transits'] && canWrite()
        && (resource.data.get('ownerId', '') == me() || me() in resource.data.get('editors', []));
    }

    // ── Trash: each member's own ─────────────────────────────
    match /users/public/trash/{docId} {
      allow read: if signedIn() && resource.data.get('ownerId', '') == me();
      allow create: if canWrite() && request.resource.data.get('ownerId', '') == me();
      allow update, delete: if canWrite() && resource.data.get('ownerId', '') == me();
    }

    // Everything else (including the 'mail' queue) stays closed.
  }
}
