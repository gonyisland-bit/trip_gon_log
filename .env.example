# Cloudflare R2 (server-only: used by api/r2.ts and the Vite dev middleware; never exposed to the browser)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=tripgon

# Public (bundled into the client)
VITE_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
VITE_OCR_SPACE_KEY=your_ocr_space_api_key
